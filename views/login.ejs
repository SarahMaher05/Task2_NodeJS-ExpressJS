<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nevermore Academy - Login</title>
    
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🕷️</text></svg>">

    <link href="https://fonts.googleapis.com/css2?family=Special+Elite&family=Unica+One&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/css/wednesday.css">
</head>
<body>

    <div class="login-container">
        
        <form action="/auth/login" method="POST" class="login-form">
            
            <div class="form-logo">🕷️</div> <h1 class="form-title">NEVERMORE ACADEMY</h1>
            <p class="form-subtitle">"Please login to access the registry"</p>
            
            <div class="input-group">
                <input type="text" id="username" name="username" class="form-input" required autocomplete="off" placeholder=" ">
                <label for="username" class="form-label">Identity (Username)</label>
            </div>
            
            <div class="input-group">
                <input type="password" id="password" name="password" class="form-input" required placeholder=" ">
                <label for="password" class="form-label">Secret Code (Password)</label>
            </div>
            
            <button type="submit" class="cta-button">
                <span>Login</span>
            </button>
            
            <p class="form-footer">
                Not an outcast? <a href="/auth/register">Apply for admission</a>
            </p>
            

        </form>
    </div>

</body>
</html>