<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nevermore Dashboard</title>

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🕷️</text></svg>">


    <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/darkly/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Special+Elite&family=Unica+One&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Special Elite', monospace; }
        .navbar-brand, h1 { font-family: 'Unica One', cursive; letter-spacing: 2px; }
        .table { font-size: 1.1rem; }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/characters">🕷️ NEVERMORE</a>
            <a href="/auth/logout" class="btn btn-outline-light">Logout</a>
        </div>
    </nav>

    <div class="container mt-5">
        <h1 class="mb-4">Outcast Registry</h1>

        <div class="row mb-3">
            <div class="col-md-8">
                <form action="/characters/search" method="GET">
                    <div class="input-group">
                        <input type="text" name="query" class="form-control" placeholder="Search by name...">
                        <button class="btn btn-light" type="submit">Search</button>
                    </div>
                </form>
            </div>
            <div class="col-md-4 text-end">
                <a href="/characters/new" class="btn btn-light">Add New Outcast</a>
            </div>
        </div>

        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>#</th> 
                    <th>Name</th>
                    <th>Species</th> <th>Ability</th> <th>Added At</th> 
                    <th>Last Updated</th> 
                    <th>Actions</th> 
                </tr>
            </thead>
            <tbody>
                <% if (characters.length > 0) { %>
                    <% characters.forEach((char, index) => { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td><%= char.name %></td>
                            <td><%= char.species %></td> <td><%= char.ability %></td> <td><%= char.createdAt.toLocaleString('en-US') %></td>
                            <td><%= char.updatedAt.toLocaleString('en-US') %></td>
                            <td>
                                <a href="/characters/edit/<%= char._id %>" class="btn btn-secondary btn-sm me-1">Edit</a>
                                <form action="/characters/delete/<%= char._id %>" method="POST" class="d-inline">
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="7" class="text-center">No outcasts found. Add one.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
        

    </div>
</body>
</html>